/* 骨架屏 —— 白底 + 浅灰占位，带流光动画 */
.sk { padding: 0; }

.sk-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.sk-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}
.sk-col { flex: 1; margin-left: 16rpx; }
.sk-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #EEF1F5 25%, #F7F9FC 37%, #EEF1F5 63%);
  background-size: 400% 100%;
  animation: sk-flow 1.4s ease infinite;
  flex-shrink: 0;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #EEF1F5 25%, #F7F9FC 37%, #EEF1F5 63%);
  background-size: 400% 100%;
  animation: sk-flow 1.4s ease infinite;
}
.sk-line:last-child { margin-bottom: 0; }
.sk-line.h16 { height: 16rpx; }
.sk-line.h28 { height: 28rpx; }
.w25 { width: 25%; }
.w40 { width: 40%; }
.w50 { width: 50%; }
.w60 { width: 60%; }
.w70 { width: 70%; }
.w80 { width: 80%; }
.w90 { width: 90%; }
.w100 { width: 100%; }

.sk-img {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  background: linear-gradient(90deg, #EEF1F5 25%, #F7F9FC 37%, #EEF1F5 63%);
  background-size: 400% 100%;
  animation: sk-flow 1.4s ease infinite;
}
.sk-img.tall { height: 380rpx; }

.sk-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.sk-grid-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
}
.sk-block {
  width: 100%;
  height: 240rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #EEF1F5 25%, #F7F9FC 37%, #EEF1F5 63%);
  background-size: 400% 100%;
  animation: sk-flow 1.4s ease infinite;
}

@keyframes sk-flow {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
