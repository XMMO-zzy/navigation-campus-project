/* pages/search/index.wxss — 全局搜索 */
page {
  background: var(--c-bg-page);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--c-border-light);
}
.search-bar__box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #F4F6FA;
}
.search-bar__icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-bar__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text-1);
}
.search-bar__clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #C9D3E0;
}
.search-bar__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 0 12rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--c-primary);
}

/* 区块 */
.section {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
}
.section__head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.section__title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--c-text-1);
}
.section__action {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--c-text-3);
}

/* 关键词 */
.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  display: flex;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 12rpx 22rpx;
  font-size: 26rpx;
  color: var(--c-text-1);
  background: #F4F6FA;
  border-radius: 999rpx;
}
.chip__close {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--c-text-3);
  line-height: 1;
}
.chip--hot {
  color: var(--c-primary);
  background: var(--c-primary-light);
}
.chip__rank {
  margin-right: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--c-danger);
}

.search-tip {
  padding: 160rpx 0;
  text-align: center;
}
.search-tip__glyph {
  font-size: 90rpx;
  opacity: .28;
}
.search-tip__text {
  margin-top: 20rpx;
  font-size: 27rpx;
  color: var(--c-text-3);
}

/* 类型页签 */
.tabs {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}
.tabs__item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
  background: #F4F6FA;
  border-radius: 999rpx;
}
.tabs__item--on {
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-weight: 600;
}

/* 结果 */
.result-count {
  padding: 22rpx 28rpx 6rpx;
  font-size: 24rpx;
  color: var(--c-text-3);
}
.list {
  padding: 12rpx 24rpx 0;
}
.result {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.result__head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.result__tag {
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  border-radius: 6rpx;
  background: var(--c-primary-light);
  color: var(--c-primary);
}
.result__time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--c-text-3);
}
.result__title {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--c-text-1);
}
.result__summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--c-text-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ph {
  color: #A9B4C4;
}
