@import "../../styles/detail-common.wxss";

/* ==========================================================================
   pages/team/detail —— 队伍详情
   ========================================================================== */

/* ---- 队伍头部 ---- */
.team-hero {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #1E6FE8 0%, #4E93F5 100%);
}
.team-hero__avatar {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .22);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.team-hero__main { flex: 1; margin-left: 24rpx; min-width: 0; }
.team-hero__name {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-hero__meta { display: flex; align-items: center; margin-top: 14rpx; }
.team-hero__meta .tag {
  background: rgba(255, 255, 255, .22);
  color: #FFFFFF;
}
.team-hero__member {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .9);
}

/* ---- 公告 ---- */
.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.notice-edit {
  font-size: 25rpx;
  font-weight: 400;
  color: var(--c-primary);
}
.notice-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--c-text-3);
}
.rich {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--c-text-2);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---- 成员 ---- */
.member {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-border-light);
}
.member:last-child { border-bottom: none; }
.member__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #EDF1F7;
}
.member__main { flex: 1; margin-left: 18rpx; min-width: 0; }
.member__name {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 500;
  color: var(--c-text-1);
}
.member__me {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #E8F1FE;
  color: var(--c-primary);
  font-size: 20rpx;
}
.member__duty {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--c-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member__role { flex-shrink: 0; margin-left: 12rpx; }
.member__manage {
  flex-shrink: 0;
  width: 56rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--c-text-3);
  letter-spacing: 2rpx;
}
