/* pages/order/list.wxss — 我的订单 */
page {
  background: var(--c-bg-page);
}
.page {
  padding-bottom: 40rpx;
}

/* 角色切换 */
.role-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}
.role-tabs__item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0 22rpx;
  font-size: 30rpx;
  color: var(--c-text-2);
  position: relative;
}
.role-tabs__item--on {
  color: var(--c-primary);
  font-weight: 600;
}
.role-tabs__item--on::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
}

/* 状态筛选 */
.status-tabs {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid var(--c-border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}
.status-tabs__item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
  background: #F4F6FA;
  border-radius: 999rpx;
}
.status-tabs__item--on {
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-weight: 600;
}

/* 订单卡片 */
.list {
  padding: 20rpx 24rpx 0;
}
.order {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.order__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}
.order__no {
  font-size: 23rpx;
  color: var(--c-text-3);
}
.order__body {
  display: flex;
  padding: 22rpx 0;
}
.order__img {
  width: 168rpx;
  height: 168rpx;
  border-radius: 12rpx;
  background: #F2F4F7;
  flex-shrink: 0;
}
.order__info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.order__title {
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.45;
  color: var(--c-text-1);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.order__meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--c-text-3);
}
.order__price-row {
  margin-top: auto;
}
.order__price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-danger);
}

/* 交易对手 */
.order__counterparty {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  border-top: 1rpx solid var(--c-border-light);
}
.order__cp-label {
  color: var(--c-text-3);
}
.order__cp-name {
  margin-left: 12rpx;
  color: var(--c-text-1);
  font-weight: 500;
}
.order__time {
  margin-left: auto;
  color: var(--c-text-3);
}

/* 底部操作 */
.order__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--c-border-light);
}
.order__tip {
  flex: 1;
  font-size: 24rpx;
  color: var(--c-text-3);
}
.order__deadline {
  color: var(--c-warning);
  margin-left: 12rpx;
}
.order__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 34rpx;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: #FFFFFF;
}
