/* 消息页 —— 四段结构 */
.page-wrap { background-color: #F5F7FA; min-height: 100vh; }

.nav-act {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-act-icon { font-size: 38rpx; color: #4A5468; }

/* ---- 页面顶部 ---- */
.msg-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background-color: #FFFFFF;
  padding: 4rpx 32rpx 0;
}
.box-switch { display: flex; flex-direction: row; align-items: center; }
.box-item {
  font-size: 30rpx;
  color: #8C96A5;
  margin-right: 40rpx;
  padding: 16rpx 0 20rpx;
  position: relative;
}
.box-item.active {
  color: #1A2233;
  font-weight: 600;
}
.box-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background-color: #1E6FE8;
}
.box-dot {
  position: absolute;
  top: 18rpx;
  right: -14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #F04438;
}
.read-all {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 24rpx;
  color: #1E6FE8;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #F4F8FF;
}
.read-all:active { background-color: #E8F1FE; }
.read-all-icon { margin-right: 6rpx; font-size: 24rpx; }

/* ---- 分类入口 ---- */
.biz-tabs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  background-color: #FFFFFF;
  padding: 18rpx 24rpx 22rpx;
  border-bottom: 1rpx solid #EEF1F5;
}
.biz-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #4A5468;
  background-color: #F5F7FA;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.biz-tab.active {
  background-color: #1E6FE8;
  color: #FFFFFF;
  font-weight: 500;
}

/* ---- 组队协作 ---- */
.collab-section { margin-top: 16rpx; }
.collab-more { font-size: 24rpx; color: #1E6FE8; }

.apply-summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #F4F8FF;
  border-radius: 14rpx;
  padding: 22rpx;
  margin-top: 16rpx;
}
.apply-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background-color: #1E6FE8;
  flex-shrink: 0;
}
.apply-badge-num {
  font-size: 46rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1.1;
}
.apply-badge-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}
.apply-list { flex: 1; min-width: 0; margin-left: 20rpx; }
.apply-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0;
}
.apply-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #E8F1FE;
  flex-shrink: 0;
}
.apply-main { flex: 1; min-width: 0; margin-left: 14rpx; }
.apply-name { font-size: 25rpx; color: #1A2233; display: block; }
.apply-team { font-size: 21rpx; color: #8C96A5; display: block; }

/* ---- 私信入口 ---- */
.chat-section { margin-top: 16rpx; padding: 26rpx 24rpx; }
.chat-icon { font-size: 34rpx; margin-right: 14rpx; }
.chat-title { font-size: 28rpx; color: #1A2233; font-weight: 500; }

/* ---- 消息列表 ---- */
.msg-list { padding: 0 24rpx; margin-top: 16rpx; }
.msg-item {
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 14rpx;
}
.msg-item:active { background-color: #FCFDFF; }
.msg-item-left {
  width: 24rpx;
  flex-shrink: 0;
  padding-top: 10rpx;
}
.msg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #F04438;
}
.msg-item-main { flex: 1; min-width: 0; }
.msg-item-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.msg-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2233;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}
.msg-time { font-size: 22rpx; color: #B4BCCA; flex-shrink: 0; }
.msg-content {
  font-size: 25rpx;
  color: #4A5468;
  line-height: 1.6;
  margin-top: 10rpx;
}
.msg-item-foot { margin-top: 12rpx; }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: block;
}
