/* pages/notice/index.wxss — 通知公告 */
page {
  background: var(--c-bg-page);
}

/* 分类页签 */
.tabs {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}
.tabs__item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
  background: #F4F6FA;
  border-radius: 999rpx;
}
.tabs__item--on {
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-weight: 600;
}

/* 列表 */
.list {
  padding: 20rpx 24rpx 0;
}
.notice-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}
.notice-item__head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.notice-item__tag {
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  border-radius: 6rpx;
  background: var(--c-primary-light);
  color: var(--c-primary);
}
.notice-item__date {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--c-text-3);
}
.notice-item__title {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--c-text-1);
}
.notice-item__summary {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--c-text-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 详情 */
.article {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
}
.article__tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  background: var(--c-primary-light);
  color: var(--c-primary);
}
.article__title {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--c-text-1);
}
.article__meta {
  margin-top: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--c-border-light);
  font-size: 23rpx;
  color: var(--c-text-3);
}
.article__content {
  margin-top: 26rpx;
  font-size: 30rpx;
  line-height: 1.85;
  color: var(--c-text-1);
  white-space: pre-wrap;
  word-break: break-all;
}
.article__source {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 14rpx;
  background: var(--c-primary-light);
  font-size: 27rpx;
  color: var(--c-primary);
}
.article__source-arrow {
  margin-left: 10rpx;
  font-size: 32rpx;
}
