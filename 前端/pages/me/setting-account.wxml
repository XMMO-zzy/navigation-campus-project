<!-- pages/me/setting-account.wxml — 账号管理 -->
<view class="page">
  <nav-bar title="账号管理" back="{{true}}" />

  <block wx:if="{{isLogin}}">
    <view class="group">
      <view class="cell">
        <text class="cell__label">昵称</text>
        <text class="cell__value">{{user.nickname || '—'}}</text>
      </view>
      <view class="cell">
        <text class="cell__label">学号</text>
        <text class="cell__value">{{user.studentNo || '未认证'}}</text>
      </view>
      <view class="cell">
        <text class="cell__label">身份</text>
        <text class="cell__value">{{user.userType === 2 ? '认证用户' : '普通用户'}}</text>
      </view>
      <view class="cell cell--last" bindtap="onGoVerify">
        <text class="cell__label">学号认证</text>
        <text class="cell__value">{{user.verifyStatus === 2 ? '已认证' : (user.verifyStatus === 1 ? '审核中' : (user.verifyStatus === 3 ? '未通过' : '未认证'))}}</text>
        <text class="cell__arrow">›</text>
      </view>
    </view>

    <view class="group">
      <view wx:if="{{!editingPhone}}" class="cell cell--last" bindtap="onEditPhone">
        <text class="cell__label">手机号</text>
        <text class="cell__value">{{phoneText || '未绑定'}}</text>
        <text class="cell__arrow">›</text>
      </view>

      <block wx:else>
        <view class="edit-form">
          <view class="edit-form__title">更换手机号</view>
          <view class="edit-form__row">
            <input
              class="edit-form__input"
              type="number"
              maxlength="11"
              placeholder="请输入新手机号"
              placeholder-class="ph"
              value="{{newPhone}}"
              data-field="newPhone"
              bindinput="onInput"
            />
          </view>
          <view class="edit-form__row edit-form__row--code">
            <input
              class="edit-form__input"
              type="number"
              maxlength="6"
              placeholder="请输入验证码"
              placeholder-class="ph"
              value="{{smsCode}}"
              data-field="smsCode"
              bindinput="onInput"
            />
            <view class="edit-form__code {{counting > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
              {{counting > 0 ? counting + 's' : '获取验证码'}}
            </view>
          </view>
          <view class="edit-form__actions">
            <view class="edit-form__btn edit-form__btn--ghost" bindtap="onCancelEditPhone">取消</view>
            <view class="edit-form__btn" bindtap="onSavePhone">保存</view>
          </view>
        </view>
      </block>
    </view>

    <view class="group">
      <view class="cell cell--last" bindtap="onSecurity">
        <text class="cell__label">账号安全</text>
        <text class="cell__arrow">›</text>
      </view>
    </view>

    <view class="tip">账号与微信绑定后可一键登录，解绑后需使用手机号登录。</view>
  </block>

  <empty
    wx:else
    icon="🔐"
    text="请先登录"
    desc="登录后可管理账号信息"
    action-text="去登录"
    bind:action="onGoLogin"
  />
  <view class="safe-bottom"></view>
</view>
