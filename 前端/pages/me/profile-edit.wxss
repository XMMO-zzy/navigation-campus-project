/* pages/me/profile-edit.wxss — 编辑资料 / 他人主页 */
page {
  background: var(--c-bg-page);
}

.nav-save {
  padding: 0 16rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, .5);
}
.nav-save.on {
  color: #FFFFFF;
  font-weight: 600;
}

/* 区块 */
.block {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}
.block__head {
  display: flex;
  align-items: center;
  padding: 22rpx 0 16rpx;
}
.block__title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--c-text-1);
}
.block__action {
  margin-left: auto;
  font-size: 25rpx;
  color: var(--c-primary);
}

/* 头像行 */
.avatar-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.avatar-row__label {
  flex: 1;
  font-size: 29rpx;
  color: var(--c-text-1);
}
.avatar-row__img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
}
.avatar-row__arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  color: #C0CAD8;
}

/* 字段 */
.field {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-border-light);
}
.field--last {
  border-bottom: none;
}
.field__label {
  font-size: 26rpx;
  color: var(--c-text-2);
  margin-bottom: 12rpx;
}
.field__input {
  width: 100%;
  height: 56rpx;
  font-size: 30rpx;
  color: var(--c-text-1);
}
.field__textarea {
  width: 100%;
  height: 160rpx;
  font-size: 29rpx;
  line-height: 1.65;
  color: var(--c-text-1);
}
.field__count {
  text-align: right;
  font-size: 22rpx;
  color: var(--c-text-3);
}

/* 标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 16rpx;
}
.chips--selected {
  padding-top: 6rpx;
  border-top: 1rpx dashed var(--c-border-light);
  margin-top: 6rpx;
  padding-bottom: 20rpx;
}
.chip {
  margin: 0 14rpx 14rpx 0;
  padding: 12rpx 26rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
  background: #F4F6FA;
  border-radius: 999rpx;
}
.chip--on {
  color: var(--c-primary);
  background: var(--c-primary-light);
  font-weight: 500;
}

.tip {
  margin: 22rpx 32rpx 0;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--c-text-3);
}

/* 底部 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--c-border);
}
.footer__btn {
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  border-radius: 45rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}
.footer__btn--disabled {
  background: #C6D4E8;
}

/* 他人主页头部 */
.hero {
  padding: 44rpx 32rpx 40rpx;
  text-align: center;
  background: linear-gradient(160deg, #EAF2FE 0%, #FFFFFF 80%);
}
.hero__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  border: 6rpx solid #FFFFFF;
}
.hero__name {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--c-text-1);
}
.hero__badge {
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--c-primary);
  background: var(--c-primary-light);
  border-radius: 8rpx;
}
.hero__meta {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--c-text-2);
}
.hero__bio {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--c-text-2);
}

/* 只读行 */
.row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--c-border-light);
}
.row:last-child {
  border-bottom: none;
}
.row__label {
  flex: 1;
  font-size: 29rpx;
  color: var(--c-text-1);
}
.row__arrow {
  font-size: 34rpx;
  color: #C0CAD8;
}
.ph {
  color: #A9B4C4;
}
