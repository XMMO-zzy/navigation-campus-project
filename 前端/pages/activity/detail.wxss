@import "../../styles/detail-common.wxss";

/* ==========================================================================
   pages/activity/detail —— 活动详情
   ========================================================================== */

/* ---- 封面 ---- */
.cover { position: relative; width: 100%; height: 420rpx; background: #EDF1F7; }
.cover__img { width: 100%; height: 100%; display: block; }
.cover__status {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  color: #FFFFFF;
  background: rgba(16, 24, 40, .62);
}

/* ---- 标题区 ---- */
.head {
  margin: -30rpx 24rpx 0;
  position: relative;
  z-index: 2;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx 24rpx;
}
.head__title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--c-text-1);
}
.head__tags { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.head__tags .tag { margin-right: 12rpx; }
.head__stat {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--c-border-light);
}
.head__stat-item { flex: 1; text-align: center; }
.head__stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--c-primary);
}
.head__stat-label { margin-top: 4rpx; font-size: 22rpx; color: var(--c-text-3); }

/* ---- 富文本 ---- */
.rich {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--c-text-2);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---- 组织者 ---- */
.author {
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}
.author__avatar { width: 84rpx; height: 84rpx; border-radius: 50%; flex-shrink: 0; background: #EDF1F7; }
.author__main { flex: 1; margin-left: 20rpx; min-width: 0; }
.author__name { font-size: 30rpx; font-weight: 600; color: var(--c-text-1); }
.author__meta { margin-top: 8rpx; font-size: 24rpx; color: var(--c-text-3); }
.author__arrow { font-size: 40rpx; color: var(--c-text-3); line-height: 1; }

/* ---- 报名表单 ---- */
.sheet-field { padding: 14rpx 0; }
.sheet-field__label {
  font-size: 26rpx;
  color: var(--c-text-1);
  font-weight: 500;
  margin-bottom: 12rpx;
}
.sheet-field__input {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #F8FAFD;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--c-text-1);
}
.sheet-field__textarea {
  width: 100%;
  height: 140rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  background: #F8FAFD;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.req { color: var(--c-danger); margin-left: 6rpx; }

/* ---- 报名审核列表 ---- */
.review-list { max-height: 720rpx; }
.review-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-text-3);
}
.review-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--c-border-light);
}
.review-item:last-child { border-bottom: none; }
.review-item__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #EDF1F7;
}
.review-item__main { flex: 1; margin-left: 18rpx; min-width: 0; }
.review-item__name { font-size: 28rpx; font-weight: 500; color: var(--c-text-1); }
.review-item__meta { margin-top: 6rpx; font-size: 22rpx; color: var(--c-text-3); }
.review-item__acts { display: flex; flex-shrink: 0; }
.review-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  margin-left: 12rpx;
}
.review-btn--ok { background: var(--c-primary); color: #FFFFFF; }
.review-btn--no { background: #F4F6FA; color: var(--c-text-2); }
