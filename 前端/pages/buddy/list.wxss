@import "../../styles/list-common.wxss";

/* pages/buddy/list.wxss — 找搭子 */

.buddy {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.buddy__head {
  display: flex;
  align-items: center;
}
.buddy__type {
  padding: 4rpx 16rpx;
  font-size: 21rpx;
  border-radius: 6rpx;
  color: #FFFFFF;
  background: var(--c-dom-buddy);
}
.buddy__gender {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 21rpx;
  border-radius: 6rpx;
  background: #F1EDFE;
  color: var(--c-dom-competition);
}
.buddy__closed {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--c-text-3);
}
.buddy__title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--c-text-1);
}
.buddy__content {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--c-text-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.buddy__meta {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}
.buddy__meta-item {
  margin: 0 20rpx 8rpx 0;
  font-size: 23rpx;
  color: var(--c-text-3);
}
.buddy__foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--c-border-light);
}
.buddy__author {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.buddy__avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
}
.buddy__name {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--c-text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.buddy__quota {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}
.buddy__quota-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-dom-buddy);
}
.buddy__quota-label {
  margin-left: 6rpx;
  font-size: 21rpx;
  color: var(--c-text-3);
}
