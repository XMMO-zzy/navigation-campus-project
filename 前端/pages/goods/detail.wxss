/* pages/goods/detail.wxss — 商品详情 */
page {
  background: var(--c-bg-page);
  padding-bottom: 120rpx;
}

/* 图片轮播 */
.gallery {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: #F2F4F7;
}
.gallery__img {
  width: 100%;
  height: 600rpx;
  display: block;
}
.gallery__badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: rgba(16, 24, 40, 0.62);
  color: #FFFFFF;
}
.gallery__count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: rgba(16, 24, 40, 0.52);
  color: #FFFFFF;
}

/* 价格区 */
.price-block {
  background: #FFFFFF;
  padding: 28rpx 24rpx 24rpx;
}
.price-block__row {
  display: flex;
  align-items: baseline;
}
.price-block__price {
  color: var(--c-danger);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
}
.price-block__price--free {
  font-size: 34rpx;
}
.price-block__origin {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--c-text-3);
  text-decoration: line-through;
}
.price-block__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.price-block__title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--c-text-1);
}
.price-block__meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--c-text-3);
}
.price-block__meta .dot {
  margin: 0 12rpx;
}

/* 通用区块 */
.section {
  margin-top: 20rpx;
  background: #FFFFFF;
  padding: 26rpx 24rpx;
}
.section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text-1);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.section__title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
  margin-right: 14rpx;
}

/* 参数行 */
.param-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 27rpx;
}
.param-row__label {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--c-text-3);
}
.param-row__value {
  flex: 1;
  color: var(--c-text-1);
  line-height: 1.55;
}
.param-row__value--strong {
  color: var(--c-primary);
  font-weight: 600;
}

/* 描述 */
.desc {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--c-text-2);
  white-space: pre-wrap;
  word-break: break-all;
}
.desc--empty {
  color: var(--c-text-3);
}

/* 卖家 */
.seller {
  display: flex;
  align-items: center;
}
.seller__avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  flex-shrink: 0;
}
.seller__info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.seller__name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--c-text-1);
  display: flex;
  align-items: center;
}
.seller__sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--c-text-3);
}
.seller__arrow {
  font-size: 26rpx;
  color: var(--c-text-3);
}

/* 交易安全提示 */
.tips {
  background: #FFF9EC;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  margin: 20rpx 24rpx 0;
}
.tips__head {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--c-warning);
  margin-bottom: 12rpx;
}
.tips__item {
  font-size: 25rpx;
  line-height: 1.7;
  color: #8A5B00;
  padding-left: 26rpx;
  position: relative;
}
.tips__item::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--c-warning);
}

/* 联系方式（锁定/解锁） */
.contact {
  margin-top: 20rpx;
  background: #FFFFFF;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
}
.contact--locked {
  background: #F8F9FB;
}
.contact__icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.contact__main {
  flex: 1;
  min-width: 0;
}
.contact__title {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--c-text-1);
}
.contact__value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--c-primary);
  letter-spacing: 2rpx;
}
.contact__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-text-3);
}
.contact__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: #FFFFFF;
}
.contact__btn--ghost {
  background: var(--c-primary-light);
  color: var(--c-primary);
}

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  background: #FFFFFF;
  border-top: 1rpx solid var(--c-border);
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
}
.footer-bar__icon {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.footer-bar__icon-glyph {
  font-size: 38rpx;
  line-height: 1.1;
}
.footer-bar__icon-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
}
.footer-bar__icon--active .footer-bar__icon-text {
  color: var(--c-primary);
}
.footer-bar__main {
  flex: 1;
  margin-left: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 600;
}
.footer-bar__main--disabled {
  background: #C6D4E8;
}
.footer-bar__main--ghost {
  background: #FFFFFF;
  color: var(--c-primary);
  border: 2rpx solid var(--c-primary);
}
.footer-bar__manage {
  flex: 1;
  margin-left: 16rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 31rpx;
  font-weight: 600;
  background: var(--c-primary-light);
  color: var(--c-primary);
}

/* 悬浮提示 */
.hint-bar {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 22rpx;
  background: var(--c-primary-light);
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--c-primary-dark);
  line-height: 1.6;
}
