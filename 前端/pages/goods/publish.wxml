<!-- pages/goods/publish.wxml — 商品发布 3 步向导 -->
<view class="page">
  <nav-bar title="{{goodsId ? '编辑商品' : '发布二手'}}" back="{{true}}" />

  <!-- 步骤条 -->
  <view class="steps">
    <view
      wx:for="{{['1','2','3']}}"
      wx:key="*this"
      class="steps__item {{step >= item ? 'steps__item--on' : ''}} {{step > item ? 'steps__item--done' : ''}}"
      data-step="{{item}}"
      bindtap="onTapStep"
    >
      <view class="steps__dot">{{step > item ? '✓' : item}}</view>
      <view class="steps__text">{{item === '1' ? '商品图片' : (item === '2' ? '商品信息' : '交易方式')}}</view>
    </view>
    <view class="steps__line"></view>
  </view>

  <!-- 第 1 步：图片 -->
  <block wx:if="{{step === 1}}">
    <view class="panel">
      <view class="panel__title">上传商品图片</view>
      <view class="panel__hint">最多 9 张，建议首图为实物正面清晰照</view>
      <view class="uploader">
        <view
          class="uploader__item"
          wx:for="{{form.images}}"
          wx:key="index"
        >
          <image
            class="uploader__img"
            src="{{item}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPreviewImage"
          />
          <view class="uploader__del" data-index="{{index}}" catchtap="onDeleteImage">×</view>
          <view wx:if="{{index === 0}}" class="uploader__cover">封面</view>
        </view>
        <view
          wx:if="{{form.images.length < 9}}"
          class="uploader__add"
          bindtap="onChooseImage"
        >
          <view class="uploader__add-icon">＋</view>
          <view class="uploader__add-text">{{form.images.length}}/9</view>
        </view>
      </view>
    </view>
    <view class="panel panel--plain">
      <view class="panel__title">发布须知</view>
      <view class="notice-item">1. 仅限校内物品交易，禁止发布违禁品、仿冒品及与学业无关的营利性商品。</view>
      <view class="notice-item">2. 请勿在标题或描述中填写手机号、微信号等联系方式，联系方式在下一步单独填写。</view>
      <view class="notice-item">3. 商品信息提交后需经过内容审核，审核通过后才会公开展示。</view>
    </view>
  </block>

  <!-- 第 2 步：信息 -->
  <block wx:if="{{step === 2}}">
    <view class="panel">
      <view class="field">
        <view class="field__label">商品标题<text class="req">*</text></view>
        <input
          class="field__input"
          placeholder="如：大疆 Mini 3 无人机 带包"
          placeholder-class="ph"
          maxlength="40"
          value="{{form.title}}"
          data-field="title"
          bindinput="onInput"
        />
        <view class="field__count">{{form.title.length}}/40</view>
      </view>

      <view class="field">
        <view class="field__label">商品描述</view>
        <textarea
          class="field__textarea"
          placeholder="描述一下成色、使用时长、配件情况、是否有磕碰等"
          placeholder-class="ph"
          maxlength="500"
          value="{{form.description}}"
          data-field="description"
          bindinput="onInput"
        />
        <view class="field__count">{{form.description.length}}/500</view>
      </view>
    </view>

    <view class="panel">
      <picker
        mode="selector"
        range="{{categoryLabels}}"
        data-field="category"
        bindchange="onPicker"
      >
        <view class="picker-row">
          <view class="picker-row__label">商品分类<text class="req">*</text></view>
          <view class="picker-row__value {{categoryText ? '' : 'ph'}}">
            {{categoryText || '请选择'}}
          </view>
          <view class="picker-row__arrow">›</view>
        </view>
      </picker>
      <view class="divider"></view>
      <picker
        mode="selector"
        range="{{conditionLabels}}"
        data-field="cond"
        bindchange="onPicker"
      >
        <view class="picker-row">
          <view class="picker-row__label">商品成色<text class="req">*</text></view>
          <view class="picker-row__value {{condText ? '' : 'ph'}}">
            {{condText || '请选择'}}
          </view>
          <view class="picker-row__arrow">›</view>
        </view>
      </picker>
    </view>

    <view class="panel">
      <view class="field">
        <view class="field__label">出售价格（元）<text class="req">*</text></view>
        <input
          class="field__input field__input--price"
          type="digit"
          placeholder="0.00"
          placeholder-class="ph"
          value="{{form.price}}"
          data-field="price"
          bindinput="onInput"
        />
        <view wx:if="{{form.price}}" class="field__clear" data-field="price" catchtap="onClear">×</view>
      </view>
      <view class="field">
        <view class="field__label">原价（选填）</view>
        <input
          class="field__input"
          type="digit"
          placeholder="填写原价可展示划线价"
          placeholder-class="ph"
          value="{{form.originPrice}}"
          data-field="originPrice"
          bindinput="onInput"
        />
      </view>
    </view>
  </block>

  <!-- 第 3 步：交易方式 -->
  <block wx:if="{{step === 3}}">
    <view class="panel">
      <view class="field">
        <view class="field__label">交易地点<text class="req">*</text></view>
        <input
          class="field__input"
          placeholder="如：一号教学楼一楼大厅"
          placeholder-class="ph"
          maxlength="40"
          value="{{form.tradePlace}}"
          data-field="tradePlace"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <view class="field__label">联系方式<text class="req">*</text></view>
        <input
          class="field__input"
          placeholder="手机号或微信号（仅买家下单后可见）"
          placeholder-class="ph"
          maxlength="40"
          value="{{form.contact}}"
          data-field="contact"
          bindinput="onInput"
        />
      </view>
      <view class="panel__hint panel__hint--warn">
        联系方式仅在买家提交订单后向其展示，未下单用户无法查看。
      </view>
    </view>

    <view class="panel">
      <view class="panel__title">发布预览</view>
      <view class="preview">
        <image
          class="preview__img"
          src="{{form.images[0] || '/static/placeholder.png'}}"
          mode="aspectFill"
        />
        <view class="preview__body">
          <view class="preview__title">{{form.title || '商品标题'}}</view>
          <view class="preview__meta">{{condText || '成色'}} · {{categoryText || '分类'}}</view>
          <view class="preview__price">¥{{form.price || '0.00'}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部按钮 -->
  <view class="footer">
    <view wx:if="{{step > 1}}" class="footer__btn footer__btn--ghost" bindtap="onPrev">上一步</view>
    <view wx:if="{{step < 3}}" class="footer__btn" bindtap="onNext">下一步</view>
    <view
      wx:if="{{step === 3}}"
      class="footer__btn {{submitting ? 'footer__btn--disabled' : ''}}"
      bindtap="onSubmit"
    >{{submitting ? '提交中…' : (goodsId ? '保存修改' : '发布商品')}}</view>
  </view>
  <view class="safe-bottom"></view>
</view>
