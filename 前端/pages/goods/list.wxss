@import "../../styles/list-common.wxss";

/* 二手商品列表 —— 两栏瀑布流 */

/* ---- 筛选面板 ---- */
.filter-panel {
  background-color: #FFFFFF;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEF1F5;
}
.filter-group { margin-bottom: 24rpx; }
.filter-label {
  font-size: 25rpx;
  color: #8C96A5;
  display: block;
  margin-bottom: 16rpx;
}
.filter-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip {
  font-size: 24rpx;
  color: #4A5468;
  background-color: #F5F7FA;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}
.chip.on {
  background-color: #1E6FE8;
  color: #FFFFFF;
}
.price-range {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.price-input {
  flex: 1;
  height: 80rpx;
  background-color: #F7F9FC;
  border-radius: 12rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  color: #1A2233;
  text-align: center;
}
.price-sep { margin: 0 20rpx; color: #B4BCCA; }
.filter-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 8rpx;
}

/* ---- 两栏瀑布流 ---- */
.goods-body { padding: 20rpx 24rpx 0; }
.waterfall {
  column-count: 2;
  column-gap: 16rpx;
}
.goods-card {
  break-inside: avoid;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  display: inline-block;
  width: 100%;
}
.goods-card:active { opacity: 0.92; }
.goods-img {
  width: 100%;
  height: 320rpx;
  background-color: #F2F4F8;
  display: block;
}
.goods-info { padding: 18rpx 20rpx 20rpx; }
.goods-title {
  font-size: 27rpx;
  color: #1A2233;
  line-height: 1.45;
  min-height: 78rpx;
}
.goods-price-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 12rpx;
}
.goods-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #F04438;
}
.goods-orig {
  font-size: 22rpx;
  color: #B4BCCA;
  text-decoration: line-through;
  margin-left: 10rpx;
}
.goods-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.goods-cond {
  font-size: 21rpx;
  color: #8C96A5;
  background-color: #F2F4F8;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.goods-time { font-size: 21rpx; color: #B4BCCA; }
